<section class="section">
    <h2>Catálogo de Servicios</h2>
    <p>Listado de servicios disponibles en tiempo real con Socket.io y MongoDB.</p>

    <!-- Formulario para agregar servicio en tiempo real -->
    <div class="card form-card">
        <h3>Agregar Nuevo Servicio (Tiempo Real)</h3>
        <form id="serviceForm" class="grid-form">
            <div class="form-group">
                <label for="name">Nombre:</label>
                <input type="text" id="name" name="name" required placeholder="Ej: Fisioterapia">
            </div>
            <div class="form-group">
                <label for="description">Descripción:</label>
                <input type="text" id="description" name="description" required placeholder="Ej: Sesión de rehabilitación">
            </div>
            <div class="form-group">
                <label for="duration">Duración:</label>
                <input type="text" id="duration" name="duration" required placeholder="Ej: 45 minutos">
            </div>
            <div class="form-group">
                <label for="price">Precio ($):</label>
                <input type="number" id="price" name="price" required placeholder="Ej: 4500" min="0">
            </div>
            <div class="form-group">
                <label for="category">Categoría:</label>
                <input type="text" id="category" name="category" required placeholder="Ej: Kinesiología">
            </div>
            <div class="form-group checkbox-group">
                <label for="available">
                    <input type="checkbox" id="available" name="available" checked>
                    Disponible para reservar
                </label>
            </div>
            <div class="form-group full-width">
                <button type="submit" class="btn btn-primary">Crear Servicio</button>
            </div>
        </form>
    </div>

    <!-- Contenedor de servicios renderizados server-side y actualizables vía Socket.io -->
    <div id="services-list" class="services-grid">
        {{#if services.length}}
            {{#each services}}
                <div class="service-card" data-id="{{this.id}}">
                    <div class="service-header">
                        <h3>{{this.name}}</h3>
                        <span class="badge {{#if this.available}}badge-success{{else}}badge-danger{{/if}}">
                            {{#if this.available}}Disponible{{else}}No disponible{{/if}}
                        </span>
                    </div>
                    <p class="service-desc">{{this.description}}</p>
                    <div class="service-details">
                        <p><strong>Duración:</strong> {{this.duration}}</p>
                        <p><strong>Precio:</strong> ${{this.price}}</p>
                        <p><strong>Categoría:</strong> {{this.category}}</p>
                    </div>
                </div>
            {{/each}}
        {{else}}
            <p class="no-data">No hay servicios registrados en la base de datos.</p>
        {{/if}}
    </div>
</section>
